{
  "name": "@jack/shared",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript types generated from the API's OpenAPI schema. Do not edit src/api.d.ts.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/api.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3"
  }
}

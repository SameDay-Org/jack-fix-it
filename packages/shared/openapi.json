{
  "openapi": "3.1.0",
  "info": {
    "title": "Jack Fix It API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "description": "The process is up. Checks no dependencies; this is the Railway healthcheck.",
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "Postgres answers SELECT 1 and Redis answers PING, each within the configured timeout.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Postgres or Redis did not answer in time.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Creates a customer or pro account and starts a session. Never creates staff accounts.",
        "operationId": "register_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "description": "validation_error: invalid email, role, locale, or password length.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "email_already_registered: the email is taken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: too many requests from this client; retry later.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the current limit window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in",
        "description": "Checks the email and password and starts a new session.",
        "operationId": "login_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid_credentials: wrong email or password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "account_suspended: the account is suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: too many requests from this client; retry later.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the current limit window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh the session",
        "description": "Spends the refresh token and returns a new access token and a new refresh token.\n\nEach refresh token works once. Presenting one that was already rotated is treated as theft:\nthe whole session is revoked, including the newest token. Clients must therefore serialize\nrefresh calls: of two concurrent calls with the same token, one succeeds and the other one\nends the session.",
        "operationId": "refresh_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid_refresh_token: unknown, expired, revoked or reused refresh token, or the account is suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: too many requests from this client; retry later.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the current limit window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log out",
        "description": "Revokes the session the refresh token belongs to. No bearer token is needed.\n\nAlways 204, so the endpoint cannot be used to test tokens. The access token is not revoked\non the server: it stops working when it expires (`expires_in`).",
        "operationId": "logout_v1_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Always, whether the token was valid, unknown, expired or revoked."
          },
          "422": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: too many requests from this client; retry later.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the current limit window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Current user",
        "description": "The caller's own account.",
        "operationId": "me_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "422": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid_token: missing, invalid or expired access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/auth/phone/send": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Send a phone verification code",
        "description": "Sends a verification code by SMS to the number, for the signed-in user.\n\nAlways 202 for a valid number, including one already verified by another account (then\nnothing is sent). The SMS provider is called after the response, so neither the answer,\nits timing nor a provider error tells whether a number is taken; a code that never\narrives surfaces at verify as invalid_code.",
        "operationId": "send_phone_code_v1_auth_phone_send_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhoneSendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted; a code is on its way by SMS."
          },
          "422": {
            "description": "validation_error: not an E.164 number, or a country code that is not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid_token: missing, invalid or expired access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: too many requests from this client; retry later.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the current limit window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/auth/phone/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Verify the phone with the code",
        "description": "Checks the code and stores the number as the user's verified phone (idempotent).",
        "operationId": "verify_phone_v1_auth_phone_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhoneVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "422": {
            "description": "validation_error: not an E.164 number, a country code that is not allowed, or a malformed code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_code: wrong, expired or used code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid_token: missing, invalid or expired access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "phone_unavailable: the number is another account's.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "verification_unavailable: the SMS provider is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: too many requests from this client; retry later.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the current limit window ends.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/uploads": {
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Get an upload URL",
        "description": "A short-lived presigned PUT URL for one file of the declared type and exact size.\n\nPUT the file to `upload_url` with exactly the returned `headers`: Content-Type and\nContent-Length are signed, so any other type or size is rejected by the storage. Keep\n`key` to attach the file to a request, job or profile.",
        "operationId": "create_upload_v1_uploads_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "upload_invalid: content type not allowed for the purpose, or size out of range; validation_error: malformed body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid_token: missing, invalid or expired access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: not a customer or pro (agents and admins upload nothing); upload_forbidden: the caller's role cannot upload for this purpose.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/uploads/download-url": {
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Get a download URL",
        "description": "A short-lived presigned GET URL for one of the caller's own files.",
        "operationId": "create_download_url_v1_uploads_download_url_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadUrlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadUrlResponse"
                }
              }
            }
          },
          "422": {
            "description": "upload_invalid: malformed key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "invalid_token: missing, invalid or expired access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: not a customer or pro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "upload_not_found: not a file of the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserOut"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token",
            "description": "Opaque. Returned once; the server keeps a hash."
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Seconds until the access token expires."
          }
        },
        "type": "object",
        "required": [
          "user",
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "title": "AuthResponse"
      },
      "CheckStatus": {
        "type": "string",
        "enum": [
          "ok",
          "fail"
        ],
        "title": "CheckStatus"
      },
      "DependencyChecks": {
        "properties": {
          "database": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "redis": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "type": "object",
        "required": [
          "database",
          "redis"
        ],
        "title": "DependencyChecks"
      },
      "DownloadUrlRequest": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 256,
            "title": "Key"
          }
        },
        "type": "object",
        "required": [
          "key"
        ],
        "title": "DownloadUrlRequest"
      },
      "DownloadUrlResponse": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Presigned GET URL."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "url",
          "expires_at"
        ],
        "title": "DownloadUrlResponse"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "LivenessResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PhoneSendRequest": {
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "title": "Phone",
            "description": "E.164, e.g. +14075550123, with an allowed country code."
          }
        },
        "type": "object",
        "required": [
          "phone"
        ],
        "title": "PhoneSendRequest"
      },
      "PhoneVerifyRequest": {
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "title": "Phone",
            "description": "The number the code was sent to."
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{4,10}$",
            "title": "Code",
            "description": "The code received by SMS."
          }
        },
        "type": "object",
        "required": [
          "phone",
          "code"
        ],
        "title": "PhoneVerifyRequest"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "checks": {
            "$ref": "#/components/schemas/DependencyChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "RefreshTokenRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token",
            "description": "The refresh token from the last AuthResponse."
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshTokenRequest"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password",
            "description": "Between the server's minimum (setting PASSWORD_MIN_LENGTH, 10 by default) and 128 characters. No composition rules."
          },
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "pro"
            ],
            "title": "Role"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ],
            "title": "Locale",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "role"
        ],
        "title": "RegisterRequest"
      },
      "UploadPurpose": {
        "type": "string",
        "enum": [
          "request_media",
          "job_photo",
          "pro_document",
          "profile_photo"
        ],
        "title": "UploadPurpose"
      },
      "UploadRequest": {
        "properties": {
          "purpose": {
            "$ref": "#/components/schemas/UploadPurpose"
          },
          "content_type": {
            "type": "string",
            "maxLength": 100,
            "title": "Content Type",
            "description": "An allowed MIME type, e.g. image/jpeg."
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes",
            "description": "Exact size of the file; it is signed into the URL."
          }
        },
        "type": "object",
        "required": [

# Local development: cp .env.example .env.local   (never commit .env files)
# Non-secret settings only.

# development | staging | production. Only production is indexable (src/app/robots.ts).
APP_ENV=development

# Server-side base URL of the API. On Railway: the api service's private domain (docs/railway.md).
# Local development: http://127.0.0.1:8000
API_INTERNAL_URL=https://api.staging.jackfixit.invalid

# The API's refresh token lifetime, mirrored for the admin panel's refresh cookie (#80): the same
# value as the api's REFRESH_TOKEN_TTL_SECONDS (2592000 by default). Required.
REFRESH_TOKEN_TTL_SECONDS=2592000

# Local development: cp .env.example .env   (never commit .env)
# Non-secret settings. Database and Redis values match the local docker-compose.yml.
# 127.0.0.1 rather than localhost: on Windows, localhost tries ::1 first and stalls ~2s.
APP_ENV=development
LOG_LEVEL=INFO
# Railway leaves HOST unset ("::", IPv4 + IPv6). 127.0.0.1 avoids IPv6-only binding on Windows.
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql://jack:jack@127.0.0.1:5432/jack
REDIS_URL=redis://127.0.0.1:6379/0
# CSV of browser origins allowed to call the API. Empty means no cross-origin browser calls.
CORS_ORIGINS=
# Seconds each readiness probe (Postgres, Redis) may take before /health/ready returns 503.
HEALTH_CHECK_TIMEOUT_SECONDS=2
# Empty disables Sentry. Set per environment in Railway.
SENTRY_DSN=
# Auth (D4.2, #25): access and refresh token lifetimes in seconds, minimum password length.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_MIN_LENGTH=10
# Rate limits (D4.4, #28). Requests per client IP, per auth route, per window:
AUTH_RATE_LIMIT_REQUESTS=10
# Length of the fixed window, in seconds, for both limits:
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Logins per email per window, from any IP:
LOGIN_RATE_LIMIT_PER_EMAIL=5
# Seconds a limit check may wait on Redis; past it the request is allowed and an error logged:
RATE_LIMIT_TIMEOUT_SECONDS=0.5
# Seconds to wait on Redis to queue background work (dispatch #48, event pushes #55); past it
# the action still succeeds and the failure is logged:
JOB_ENQUEUE_TIMEOUT_SECONDS=2
# Seconds after a refresh during which the old refresh token, retried, gets the same new one (#152):
REFRESH_REUSE_GRACE_SECONDS=30
# Proxies trusted to set X-Forwarded-For (the client IP the limits use). Railway: see #22.
FORWARDED_ALLOW_IPS=127.0.0.1
# Uploads (D6.2, #35): presigned URL lifetimes in seconds, and maximum sizes in bytes.
S3_REGION=auto
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_VIDEO_BYTES=104857600
UPLOAD_MAX_DOCUMENT_BYTES=15728640
# Upload URLs one user may get per window (seconds) (#529); each one lets them store up to
# the purpose's largest size:
UPLOAD_URL_LIMIT=30
UPLOAD_URL_WINDOW_SECONDS=600
# The worker's sweep of uploads no row references (#191): off, dry_run (counts and logs only) or
# delete; the hours an upload must be old before it may count as orphaned; the cron interval
# (minutes); the longest one run may take (seconds):
ORPHAN_UPLOAD_MODE=dry_run
ORPHAN_UPLOAD_MIN_AGE_HOURS=24
ORPHAN_UPLOAD_SWEEP_MINUTES=60
ORPHAN_UPLOAD_SWEEP_TIMEOUT_SECONDS=1800
# The worker's own transfers (#173): seconds to connect, and to wait for each read.
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=60
# Privacy-safe copies of request photos and videos, made by the worker (#173): runs per job,
# seconds before a retry, seconds one step of a file's copy may take (download, image transform,
# ffmpeg or ffprobe run, upload), most pixels an image may decode to, JPEG/WebP re-encode
# quality, and the ffmpeg binary:
MEDIA_SANITIZE_MAX_TRIES=5
MEDIA_SANITIZE_RETRY_SECONDS=30
MEDIA_SANITIZE_TIMEOUT_SECONDS=120
MEDIA_MAX_IMAGE_PIXELS=50000000
MEDIA_JPEG_QUALITY=85
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# The only codecs a video's safe copy may carry (CSV; a video codec also needs a SEI filter in
# app/modules/media/sanitize.py, and h264 and hevc have one, #182), and the longest one job
# may run (ARQ ends it there for good, so each try stops itself first):
MEDIA_VIDEO_CODECS=h264,hevc
MEDIA_AUDIO_CODECS=aac,mp3,opus
MEDIA_SANITIZE_JOB_TIMEOUT_SECONDS=1800
# Seconds one database step of the job may take, and the end of each try kept back to ask for
# the next try or to fail what is left. The job timeout must be at least
# 7 x MEDIA_SANITIZE_TIMEOUT_SECONDS + 2 x MEDIA_SANITIZE_OVERHEAD_SECONDS + MEDIA_SANITIZE_SETTLE_SECONDS
# (a download, an HEVC video's five tool runs and an upload),
# and the settle reserve at least two database steps:
MEDIA_SANITIZE_OVERHEAD_SECONDS=30
MEDIA_SANITIZE_SETTLE_SECONDS=60
# Safe copies left pending (#473): an outage of the storage or of ffmpeg that outlasts a copy's
# tries leaves the row pending (media_sanitize_postponed), and so does a copy never queued. The
# worker's sweep runs every MEDIA_SANITIZE_RESWEEP_MINUTES and queues the copy again for up to
# MEDIA_SANITIZE_RESWEEP_BATCH_SIZE rows of each kind pending for longer than
# MEDIA_SANITIZE_RESWEEP_AFTER_MINUTES, in at most MEDIA_SANITIZE_RESWEEP_TIMEOUT_SECONDS:
MEDIA_SANITIZE_RESWEEP_MINUTES=30
MEDIA_SANITIZE_RESWEEP_AFTER_MINUTES=60
MEDIA_SANITIZE_RESWEEP_BATCH_SIZE=100
MEDIA_SANITIZE_RESWEEP_TIMEOUT_SECONDS=120
# Phone verification (D4.3, #26). Calling codes a phone may use (CSV):
PHONE_ALLOWED_COUNTRY_CODES=+1
# Codes sent and codes checked per user and per phone, per AUTH_RATE_LIMIT_WINDOW_SECONDS:
PHONE_OTP_SEND_LIMIT=3
PHONE_OTP_CHECK_LIMIT=5
# Number prefixes refused inside an allowed calling code (CSV, #526); unset, the NANP area codes
# of the countries other than the US and Canada that share +1 (see app/config.py). Empty refuses
# none:
# PHONE_EXCLUDED_PREFIXES=+1242,+1246,+1264,+1268,+1284,+1345,+1441,+1473,+1649,+1658,+1664,+1721,+1758,+1767,+1784,+1809,+1829,+1849,+1868,+1869,+1876
# Codes sent per window (seconds), failing closed (#526): per user and per number, and per
# number range (the first PHONE_OTP_PREFIX_LENGTH characters of the E.164 number):
PHONE_OTP_SEND_DAILY_LIMIT=5
PHONE_OTP_SEND_DAILY_PREFIX_LIMIT=30
PHONE_OTP_PREFIX_LENGTH=8
PHONE_OTP_SEND_DAILY_WINDOW_SECONDS=86400
# Seconds a call to Twilio Verify may take before it counts as unavailable:
TWILIO_TIMEOUT_SECONDS=5
# Password reset by emailed code (D4.3, #27): code lifetime, tries per code, and forgot/reset
# requests per IP and per email per AUTH_RATE_LIMIT_WINDOW_SECONDS:
PASSWORD_RESET_CODE_TTL_SECONDS=900
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUEST_LIMIT=3
# New codes per account per PASSWORD_RESET_DAILY_WINDOW_SECONDS; past it, forgot sends nothing:
PASSWORD_RESET_DAILY_LIMIT=5
PASSWORD_RESET_DAILY_WINDOW_SECONDS=86400
# Seconds a call to Resend may take before it counts as unavailable:
RESEND_TIMEOUT_SECONDS=5
# Sender of transactional email; required in staging and production (D4.3, #27):
# EMAIL_FROM="Jack Fix It <no-reply@example.invalid>"
# Service requests (D8.1, #42). Largest intake answers JSON, in bytes; most media per request:
REQUEST_INTAKE_MAX_BYTES=16384
REQUEST_MEDIA_MAX_ITEMS=10
# Requests a customer may create per window (seconds):
REQUEST_CREATE_LIMIT=10
REQUEST_CREATE_WINDOW_SECONDS=3600
# Seconds a create's Idempotency-Key answers its retries with the request it made (#264):
REQUEST_IDEMPOTENCY_WINDOW_SECONDS=86400
# Reverse geocoding of the device position (D8.2, #215): seconds a call to Google may take
# before it counts as unavailable, and lookups a customer may make per window (seconds):
GEOCODING_TIMEOUT_SECONDS=5
GEO_REVERSE_LIMIT=30
GEO_REVERSE_WINDOW_SECONDS=600
# Requests per list page, by default and at most:
REQUEST_LIST_DEFAULT_LIMIT=20
REQUEST_LIST_MAX_LIMIT=50
# Characters of the description a pro sees in the opportunities list (#49):
OPPORTUNITY_EXCERPT_CHARS=160
# Pro profile (D6.1, #36): the most categories and service areas one pro may list:
PRO_MAX_CATEGORIES=5
PRO_MAX_SERVICE_AREAS=50
# Push notifications (D10.3, #54): seconds per Expo or Redis call, the receipt check interval
# (minutes), how long a ticket waits for its receipt, retry backoff, sends per device before a
# retryable error is final, devices per user:
PUSH_SEND_TIMEOUT_SECONDS=5
PUSH_RECEIPT_CHECK_MINUTES=15
PUSH_TICKET_TTL_SECONDS=86400
PUSH_RETRY_BACKOFF_SECONDS=30
PUSH_MAX_ATTEMPTS=5
PUSH_MAX_DEVICES_PER_USER=10
# Quote expiry (D9.4, #51): how often the worker expires quotes past their expires_at
# (minutes), and the longest one run may take (seconds):
QUOTE_EXPIRY_SWEEP_MINUTES=5
QUOTE_EXPIRY_TIMEOUT_SECONDS=240
# Re-dispatch of requests sent while no pro was eligible (#478): the sweep's cadence (minutes of
# the hour), one run's timeout, the oldest request it reaches (days) and the requests per run.
# A value that is not a whole number in range falls back to its default, with a warning.
REDISPATCH_SWEEP_MINUTES=5
REDISPATCH_SWEEP_TIMEOUT_SECONDS=240
REDISPATCH_MAX_AGE_DAYS=7
REDISPATCH_BATCH_SIZE=100
# Minutes before the sweep tries again a request it queued (one no pro could take); it reads
# forward from where its last run stopped, so every stalled request is reached in turn:
REDISPATCH_RETRY_MINUTES=60
# Stripe webhooks (D7.3, #40): how old a signature may be (seconds), the largest body read
# (bytes), the worker's runs of one event before it is failed, and the delay before a retry
# (seconds, times the attempt number):
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_WEBHOOK_MAX_BODY_BYTES=524288
STRIPE_WEBHOOK_MAX_ATTEMPTS=5
STRIPE_WEBHOOK_RETRY_BACKOFF_SECONDS=10
# Waitlist joins per client IP and per contact, per AUTH_RATE_LIMIT_WINDOW_SECONDS (D8.4, #46):
WAITLIST_JOIN_LIMIT=5
# The app-launch interest list (#409): joins per visitor address and per email (hashed), per
# window (seconds):
INTEREST_IP_LIMIT=10
INTEREST_EMAIL_LIMIT=3
INTEREST_WINDOW_SECONDS=3600
# Web requests without an account (#86): creates per visitor address, per email and per phone
# (hashed) per window (seconds); a daily cap per email and per phone; the body's size (bytes):
WEB_REQUEST_IP_LIMIT=10
WEB_REQUEST_EMAIL_LIMIT=3
WEB_REQUEST_PHONE_LIMIT=3
WEB_REQUEST_WINDOW_SECONDS=3600
WEB_REQUEST_DAILY_LIMIT=5
WEB_REQUEST_DAILY_WINDOW_SECONDS=86400
WEB_REQUEST_MAX_BODY_BYTES=65536
# Saved addresses one customer may keep in their address book (D8.2, #214):
SAVED_ADDRESSES_MAX_PER_USER=4
# Saved-address writes (create, edit, delete) a customer may make per window (seconds):
SAVED_ADDRESS_WRITE_LIMIT=30
SAVED_ADDRESS_WRITE_WINDOW_SECONDS=600
# Pro payouts through Stripe Connect Express (D7.1, #39): seconds one Stripe call may take,
# the SDK's retries of a call that failed on the network or a 409/429/5xx, seconds after a
# lost account create before the next call looks the account up in Stripe (under 86400, as
# Stripe may forget an idempotency key after 24 h), the most pages of 100 accounts that lookup
# reads, the API's public URL (Stripe sends the pro's browser back to its pages there; https
# in staging and production), the app link those pages open, and onboarding links a pro may
# ask for per window (seconds):
STRIPE_TIMEOUT_SECONDS=10
STRIPE_MAX_NETWORK_RETRIES=0
STRIPE_ACCOUNT_RECONCILE_AFTER_SECONDS=72000
STRIPE_ACCOUNT_LIST_MAX_PAGES=10
PUBLIC_API_URL=http://localhost:8000
PAYOUTS_ONBOARDING_APP_URL=jackfixit://payouts
PAYOUTS_ONBOARDING_LINK_LIMIT=10
PAYOUTS_ONBOARDING_LINK_WINDOW_SECONDS=600
# Customer payments (D11.1, #58): seconds after a lost PaymentIntent create before the next
# call searches Stripe for it instead of creating again (under 86400, as above):
STRIPE_PAYMENT_INTENT_RECONCILE_AFTER_SECONDS=72000
# Payment sheets one customer may open per window (seconds) (#525); each one is a
# PaymentIntent read and a new CustomerSession at Stripe:
PAYMENT_SHEET_LIMIT=20
PAYMENT_SHEET_WINDOW_SECONDS=600
# Saved cards (#253): setup intents, default changes and deletes together that one customer
# may make per window (seconds):
PAYMENT_METHOD_WRITE_LIMIT=20
PAYMENT_METHOD_WRITE_WINDOW_SECONDS=600
# Wallet lists one customer may read per window (seconds) (#525); each one is two Stripe
# reads:
PAYMENT_METHOD_READ_LIMIT=60
PAYMENT_METHOD_READ_WINDOW_SECONDS=600
# Pages of 100 cards read from Stripe for one customer (more cards than that: 503), and the
# seconds a default change or a delete may take in all once the caller is authenticated: its
# wait for a database connection and for another change of the same wallet, then its own
# Stripe calls (keep it below the app's request timeout):
PAYMENT_METHOD_LIST_MAX_PAGES=5
PAYMENT_METHOD_CHANGE_TIMEOUT_SECONDS=10
# Unpaid payments (#297): seconds after its creation before a payment still unpaid is canceled
# (its quote reopens), how often the worker sweeps (minutes) and the longest one run may take
# (seconds):
PAYMENT_UNPAID_CANCEL_AFTER_SECONDS=7200
PAYMENT_UNPAID_SWEEP_MINUTES=10
PAYMENT_UNPAID_SWEEP_TIMEOUT_SECONDS=540
# Tips at confirmation (#273): the percents offered (of the job's price before tax), the
# custom amount's bounds in cents (at least the minimum, at most TIP_MAX_PERCENT of the
# price and never above TIP_MAX_CENTS) and the hours after the confirmation a tip may be
# added:
TIP_PRESET_PERCENTS=5,10,15
TIP_MIN_CENTS=100
TIP_MAX_PERCENT=100
TIP_MAX_CENTS=50000
TIP_WINDOW_HOURS=168
# Receipts (#62): who issues them (Cesar's values; unset, none is shown). The legal name and
# the support email go on the in-app receipt and the footer of every email (#92: the receipts
# and the password reset), the address in that footer only. Then the tries of one receipt
# email and the seconds between two:
# RECEIPT_LEGAL_NAME=
# RECEIPT_SUPPORT_EMAIL=
# RECEIPT_MAILING_ADDRESS=
RECEIPT_EMAIL_MAX_ATTEMPTS=5
RECEIPT_EMAIL_RETRY_SECONDS=60
# Tip choices one customer may send per window (seconds), replays included:
TIP_CHOICE_LIMIT=20
TIP_CHOICE_WINDOW_SECONDS=600
# Job execution (D12.2, #63): wrong arrival codes at check-in before the code locks:
ARRIVAL_CODE_MAX_ATTEMPTS=5
# Job photos (D12.2, #298): the most photos a job holds of each kind (before, after):
JOB_PHOTO_MAX_PER_KIND=10
# The oldest job_photo upload a job accepts, in minutes since its key was issued; at most half
# of ORPHAN_UPLOAD_MIN_AGE_HOURS (the API refuses to start otherwise):
JOB_PHOTO_ATTACH_MAX_AGE_MINUTES=720
# Job confirmation (#66, #67): hours the customer has to confirm a completed job before the
# system confirms it, how often the worker sweeps (minutes) and the longest one run may take
# (seconds):
JOB_AUTO_CONFIRM_AFTER_HOURS=48
JOB_AUTO_CONFIRM_SWEEP_MINUTES=15
JOB_AUTO_CONFIRM_SWEEP_TIMEOUT_SECONDS=840
# Disputes (#75): hours after the job is marked done during which the customer may report a
# problem (unset: JOB_AUTO_CONFIRM_AFTER_HOURS; never more than it), and the most photos one
# report holds:
# DISPUTE_WINDOW_HOURS=48
DISPUTE_PHOTO_MAX_COUNT=10
# Transfers to the pros (D13.3, #68): once a job is confirmed, the worker transfers the pro's
# payout to their Stripe account (it uses STRIPE_SECRET_KEY). How often the worker sweeps the
# confirmed jobs still to pay (minutes), the longest one run may take (seconds) and the most
# jobs one run tries. The same three bound the cron that reads made transfers again for a
# reversal (check_transfer_reversals, read-only):
TRANSFER_RELEASE_SWEEP_MINUTES=5
TRANSFER_RELEASE_SWEEP_TIMEOUT_SECONDS=270
TRANSFER_RELEASE_BATCH_SIZE=50
# Minutes an attempt with no recorded outcome is taken to be under way (nothing else calls
# Stripe for that job meanwhile); past them the next attempt looks the transfer up in Stripe
# before creating anything. Also the sweep's wait between two tries of a job that failed, and
# the reversal check's wait after its last try. At
# least twice the longest Stripe attempt (3 calls, each STRIPE_TIMEOUT_SECONDS times
# STRIPE_MAX_NETWORK_RETRIES + 1), or the API and the worker refuse to start:
TRANSFER_STUCK_PENDING_MINUTES=15
# An admin's dispute resolution that refunds the customer (#76): minutes an attempt with no
# recorded outcome is taken to be under way (another resolve of the dispute meanwhile is a
# 409); past them the next attempt looks the refund up in Stripe before creating one. At least
# twice the longest Stripe attempt (2 calls), or the API refuses to start:
REFUND_STUCK_PENDING_MINUTES=15
# Staff repair of a dispute's refund Stripe refused for good (#434, scripts.resolve_dispute_refund):
# off by default. Turn on only after the deploy that contains the abandoned-refund reader has
# finished on api AND worker, so no previous release is serving.
REFUND_ABANDON_ENABLED=false
# Cancellation (#69): the share of the job price (basis points, 1500 = 15%) the platform keeps
# when the customer cancels after the pro tapped On my way; before it a cancel is free. Read by
# the api, frozen on each cancellation:
CANCELLATION_FEE_BPS=1500
# The worker makes a cancelled job's refund (a task per cancel, and a sweep for whatever is
# left once REFUND_STUCK_PENDING_MINUTES passed): the sweep interval (minutes), the longest one
# run may take (seconds) and the most refunds one run tries:
CANCEL_REFUND_SWEEP_MINUTES=5
CANCEL_REFUND_SWEEP_TIMEOUT_SECONDS=270
CANCEL_REFUND_BATCH_SIZE=50
# Cancel previews, and cancels (retries of one count too), that one customer may ask for
# per window (seconds):
CANCEL_PREVIEW_LIMIT=60
CANCEL_PREVIEW_WINDOW_SECONDS=60
CANCEL_WRITE_LIMIT=20
CANCEL_WRITE_WINDOW_SECONDS=600
# The pro's live position while on the way (#350): kept in Redis only, the latest one per job,
# for this many seconds; one sent sooner than the minimum interval (seconds) after the stored
# one is dropped; positions one pro may send per window (seconds) before a 429; how far a
# position's own time may be ahead of or behind the server's (seconds); and the longest wait
# on Redis for one position operation (seconds):
PRO_LOCATION_TTL_SECONDS=120
PRO_LOCATION_MIN_INTERVAL_SECONDS=3
PRO_LOCATION_RATE_LIMIT=60
PRO_LOCATION_RATE_WINDOW_SECONDS=60
PRO_LOCATION_MAX_FUTURE_SECONDS=300
PRO_LOCATION_MAX_AGE_SECONDS=600
PRO_LOCATION_TIMEOUT_SECONDS=0.5
# The Redis the positions live in (#350): one of their own that keeps nothing but its live
# keys (no RDB snapshot, no AOF, slow log off). Empty here: development and test use
# REDIS_URL's. Staging and production need it (docs/railway.md, "Live positions"); without
# it the position routes answer 503. Its deployed value holds a password: Railway only.
LOCATION_REDIS_URL=
# Seconds the API remembers what that Redis says it keeps before it asks again (CONFIG GET):
LOCATION_REDIS_RECHECK_SECONDS=60
# Only for a managed Redis that refuses CONFIG GET: true takes the deployer's word that it
# keeps nothing. It never overrides a Redis that says it keeps positions.
LOCATION_REDIS_ASSUME_EPHEMERAL=false
# The route from the pro to the job's address (#351), asked of Mapbox: seconds one call may
# take before it counts as unavailable; seconds a job's computed route is kept (in the
# positions' Redis only) and reused; how far (meters) the pro may be from where that route
# starts before Mapbox is asked again; the most points of the line and the most streets an
# answer carries; seconds Mapbox is left alone for a job after it failed for it:
MAPBOX_TIMEOUT_SECONDS=5
ROUTE_CACHE_SECONDS=30
ROUTE_RETRY_SECONDS=10
ROUTE_REFRESH_DISTANCE_M=100
ROUTE_MAX_POINTS=500
ROUTE_MAX_STEPS=30
# Geocode on save (#384): true gives a request's address its point once, when the request is
# made, with Mapbox's PERMANENT geocoding, so its route asks for no geocoding. That kind is
# billed apart from the temporary one and Mapbox refuses it to an account without a payment
# method: keep it false until Cesar has set up billing on the Mapbox account
# (docs/railway.md). The worker makes the call (one per address, MAPBOX_TIMEOUT_SECONDS at the
# most) and needs MAPBOX_ACCESS_TOKEN too; the save waits only for the queue
# (JOB_ENQUEUE_TIMEOUT_SECONDS). False, or a geocode that kept nothing: the route places the
# address itself each time, as before:
GEOCODE_ON_SAVE=false
# scripts/backfill_address_geocodes.py (the addresses made before): ids read per step, and
# the most addresses it asks Mapbox about per minute:
GEOCODE_BACKFILL_BATCH_SIZE=100
GEOCODE_BACKFILL_PER_MINUTE=300
# One billed call per address per window: the worker and the backfill mark an address in the
# queue's Redis before they ask Mapbox about it, and nobody asks again for this many
# seconds (at least 60; far longer than MAPBOX_TIMEOUT_SECONDS). A backfill run within it
# skips the address:
GEOCODE_ATTEMPT_WINDOW_SECONDS=1800
# Job chat (D14.1, #71): messages one user may send in one job's chat per window (seconds):
CHAT_MESSAGE_RATE_LIMIT=20
CHAT_MESSAGE_RATE_WINDOW_SECONDS=60
# The new-message push (#73 part 1): no push to a participant who listed the chat within this
# many seconds (the app polls while the chat is on screen), and at most one push per job per
# cooldown (seconds) to one who is away:
CHAT_PRESENCE_SECONDS=15
CHAT_PUSH_COOLDOWN_SECONDS=60
# Support tickets ("Talk to Jack", #274): tickets one user may write per window (seconds):
SUPPORT_TICKET_CREATE_LIMIT=5
SUPPORT_TICKET_CREATE_WINDOW_SECONDS=3600
# Seconds a ticket create's Idempotency-Key answers its retries with the ticket it made (#380):
SUPPORT_TICKET_IDEMPOTENCY_WINDOW_SECONDS=86400
# Operations queue (#81): minutes the BDC has for the first contact with a new request (past
# it, an uncontacted request is urgent); minutes a pending quote may wait for its customer
# before the request counts as waiting on the customer; the IANA time zone "scheduled today"
# is read in.
OPS_FIRST_CONTACT_SLA_MINUTES=5
OPS_QUOTE_WAITING_MINUTES=1440
# The BDC's actions (#82): how many days ahead a follow-up may be due, and the actions (notes,
# contacted, classify, follow-ups) one staff member may take per window (seconds).
OPS_FOLLOWUP_MAX_DAYS=30
OPS_ACTION_LIMIT=60
OPS_ACTION_WINDOW_SECONDS=60
# The most pros a request's eligible list names for a manual assignment (#82), best ranked first:
OPS_ELIGIBLE_PROS_LIMIT=50
# Hours a request whose pro cancelled its job stays under problems in the queue, then leaves
# it (#69):
OPS_PRO_CANCEL_ATTENTION_HOURS=72
BUSINESS_TIME_ZONE=America/New_York
# A pro's earnings (#70): reads one pro may make per window (seconds).
EARNINGS_READ_LIMIT=60
EARNINGS_READ_WINDOW_SECONDS=60
# Staff metrics (#84): the days GET /v1/admin/metrics reads when no range is given (ending
# today in BUSINESS_TIME_ZONE), the longest range it accepts, and the reads one staff member
# may make per window (seconds).
METRICS_DEFAULT_RANGE_DAYS=30
METRICS_MAX_RANGE_DAYS=366
METRICS_READ_LIMIT=30
METRICS_READ_WINDOW_SECONDS=60
# Reviews (#77): reviews one user may write per window (seconds), over all their jobs:
REVIEW_CREATE_LIMIT=20
REVIEW_CREATE_WINDOW_SECONDS=3600
# A review counts in its target's rating once both sides reviewed the job, or this many days
# after the job's confirmation:
REVIEW_PUBLISH_AFTER_DAYS=14
# Reads of pros' public profiles and their reviews one user may make per window (seconds), both
# routes together (#78):
PRO_PUBLIC_READ_LIMIT=120
PRO_PUBLIC_READ_WINDOW_SECONDS=60
# The original of a redacted chat message (#72): kept encrypted for staff for this many days;
# the worker's purge runs every N minutes, N rows per transaction, within the timeout (seconds):
CHAT_ORIGINAL_RETENTION_DAYS=90
CHAT_ORIGINAL_PURGE_MINUTES=60
CHAT_ORIGINAL_PURGE_BATCH=500
CHAT_ORIGINAL_PURGE_TIMEOUT_SECONDS=600
# Repeat offenders (#72): this many redacted messages of one sender within this many days flag
# the sender for the BDC:
CHAT_OFFENDER_THRESHOLD=3
CHAT_OFFENDER_WINDOW_DAYS=7

# Secrets added by later tasks. Values live only in Railway variables, never in the repo.
# JWT_SECRET=                    # D4.2 (#25)
# TWILIO_ACCOUNT_SID=            # D4.3 (#26)
# TWILIO_AUTH_TOKEN=             # D4.3 (#26)
# TWILIO_VERIFY_SERVICE_SID=     # D4.3 (#26)
# RESEND_API_KEY=                # D4.3 (#27)
# S3_ENDPOINT_URL=               # D6.2 (#35)
# S3_BUCKET=                     # D6.2 (#35)
# S3_ACCESS_KEY_ID=              # D6.2 (#35)
# S3_SECRET_ACCESS_KEY=          # D6.2 (#35)
# REFRESH_ROTATION_SECRET=       # #152 (32+ chars; HMAC key deriving each rotated refresh token)
# RATE_LIMIT_KEY_SECRET=         # #137 (32+ chars; HMAC key for emails and phones in rate-limit keys)
# WEB_SERVICE_KEY=               # #409, #86 (32+ chars; the web app's server sends it as X-JFI-Web-Key: same value on both)
# STRIPE_SECRET_KEY=             # D7.1 (#39) a test key (sk_test_) outside production
# STRIPE_PUBLISHABLE_KEY=        # D11.1 (#58) the Payment Sheet's key, pk_test_ outside production; not secret, but per environment
# STRIPE_WEBHOOK_SECRET=         # D7.3 (#40)
# STRIPE_CONNECT_WEBHOOK_SECRET= # #280 the Connect endpoint's own secret (account.updated at /v1/webhooks/stripe/connect)
# GOOGLE_MAPS_API_KEY=           # D8.2 (#215, #45) optional until the Google Cloud account exists (#14)
# MAPBOX_ACCESS_TOKEN=           # #351 the route to the job's address; a secret server token. Unset: GET /v1/jobs/{job_id}/route answers 503. #384: the worker needs it too for GEOCODE_ON_SAVE
# EXPO_ACCESS_TOKEN=             # D10.3 (#54) optional; only with Expo enhanced push security
# CHAT_ORIGINAL_KEYS=            # #72 JSON {"<key id>": "<base64 32 bytes>"}; unset: no chat original is kept
# CHAT_ORIGINAL_ACTIVE_KEY_ID=   # #72 the key id new originals use (docs/railway.md, "Chat originals")

# The legal documents in force (#97): a version id each, never the text (the apps show it).
# Unset, nothing of that kind is required yet; a new version makes everyone accept it again.
# TERMS_VERSION=
# PRIVACY_VERSION=
# PRO_AGREEMENT_VERSION=
# An account deletion's cleanup by the worker (#97): the sweep's cadence (minutes of the hour),
# its longest run, the deletions one run tries, and how long a tried one waits before the next.
ACCOUNT_DELETION_SWEEP_MINUTES=10
ACCOUNT_DELETION_SWEEP_TIMEOUT_SECONDS=540
ACCOUNT_DELETION_BATCH_SIZE=50
ACCOUNT_DELETION_RETRY_AFTER_MINUTES=10
# When the worker erases a deleted account once more: past any request it sent before.
ACCOUNT_DELETION_SETTLE_SECONDS=900

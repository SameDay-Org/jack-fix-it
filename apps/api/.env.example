# Local development: cp .env.example .env   (never commit .env)
# Non-secret settings. Database and Redis values match the local docker-compose.yml.
# 127.0.0.1 rather than localhost: on Windows, localhost tries ::1 first and stalls ~2s.
APP_ENV=development
LOG_LEVEL=INFO
# Railway leaves HOST unset ("::", IPv4 + IPv6). 127.0.0.1 avoids IPv6-only binding on Windows.
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql://jack:jack@127.0.0.1:5432/jack
REDIS_URL=redis://127.0.0.1:6379/0
# CSV of browser origins allowed to call the API. Empty means no cross-origin browser calls.
CORS_ORIGINS=
# Seconds each readiness probe (Postgres, Redis) may take before /health/ready returns 503.
HEALTH_CHECK_TIMEOUT_SECONDS=2
# Empty disables Sentry. Set per environment in Railway.
SENTRY_DSN=
# Auth (D4.2, #25): access and refresh token lifetimes in seconds, minimum password length.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_MIN_LENGTH=10
# Rate limits (D4.4, #28). Requests per client IP, per auth route, per window:
AUTH_RATE_LIMIT_REQUESTS=10
# Length of the fixed window, in seconds, for both limits:
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Logins per email per window, from any IP:
LOGIN_RATE_LIMIT_PER_EMAIL=5
# Seconds a limit check may wait on Redis; past it the request is allowed and an error logged:
RATE_LIMIT_TIMEOUT_SECONDS=0.5
# Seconds to wait on Redis to queue background work (dispatch #48, event pushes #55); past it
# the action still succeeds and the failure is logged:
JOB_ENQUEUE_TIMEOUT_SECONDS=2
# Seconds after a refresh during which the old refresh token, retried, gets the same new one (#152):
REFRESH_REUSE_GRACE_SECONDS=30
# Proxies trusted to set X-Forwarded-For (the client IP the limits use). Railway: see #22.
FORWARDED_ALLOW_IPS=127.0.0.1
# Uploads (D6.2, #35): presigned URL lifetimes in seconds, and maximum sizes in bytes.
S3_REGION=auto
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_VIDEO_BYTES=104857600
UPLOAD_MAX_DOCUMENT_BYTES=15728640
# The worker's sweep of uploads no row references (#191): off, dry_run (counts and logs only) or
# delete; the hours an upload must be old before it may count as orphaned; the cron interval
# (minutes); the longest one run may take (seconds):
ORPHAN_UPLOAD_MODE=dry_run
ORPHAN_UPLOAD_MIN_AGE_HOURS=24
ORPHAN_UPLOAD_SWEEP_MINUTES=60
ORPHAN_UPLOAD_SWEEP_TIMEOUT_SECONDS=1800
# The worker's own transfers (#173): seconds to connect, and to wait for each read.
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=60
# Privacy-safe copies of request photos and videos, made by the worker (#173): runs per job,
# seconds before a retry, seconds one step of a file's copy may take (download, image transform,
# ffmpeg or ffprobe run, upload), most pixels an image may decode to, JPEG/WebP re-encode
# quality, and the ffmpeg binary:
MEDIA_SANITIZE_MAX_TRIES=5
MEDIA_SANITIZE_RETRY_SECONDS=30
MEDIA_SANITIZE_TIMEOUT_SECONDS=120
MEDIA_MAX_IMAGE_PIXELS=50000000
MEDIA_JPEG_QUALITY=85
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# The only codecs a video's safe copy may carry (CSV), and the longest one job may run (ARQ
# ends it there for good, so each try stops itself first):
MEDIA_VIDEO_CODECS=h264,hevc
MEDIA_AUDIO_CODECS=aac,mp3,opus
MEDIA_SANITIZE_JOB_TIMEOUT_SECONDS=1800
# Seconds one database step of the job may take, and the end of each try kept back to ask for
# the next try or to fail what is left. The job timeout must be at least
# 6 x MEDIA_SANITIZE_TIMEOUT_SECONDS + 2 x MEDIA_SANITIZE_OVERHEAD_SECONDS + MEDIA_SANITIZE_SETTLE_SECONDS,
# and the settle reserve at least two database steps:
MEDIA_SANITIZE_OVERHEAD_SECONDS=30
MEDIA_SANITIZE_SETTLE_SECONDS=60
# Phone verification (D4.3, #26). Calling codes a phone may use (CSV):
PHONE_ALLOWED_COUNTRY_CODES=+1
# Codes sent and codes checked per user and per phone, per AUTH_RATE_LIMIT_WINDOW_SECONDS:
PHONE_OTP_SEND_LIMIT=3
PHONE_OTP_CHECK_LIMIT=5
# Seconds a call to Twilio Verify may take before it counts as unavailable:
TWILIO_TIMEOUT_SECONDS=5
# Password reset by emailed code (D4.3, #27): code lifetime, tries per code, and forgot/reset
# requests per IP and per email per AUTH_RATE_LIMIT_WINDOW_SECONDS:
PASSWORD_RESET_CODE_TTL_SECONDS=900
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUEST_LIMIT=3
# New codes per account per PASSWORD_RESET_DAILY_WINDOW_SECONDS; past it, forgot sends nothing:
PASSWORD_RESET_DAILY_LIMIT=5
PASSWORD_RESET_DAILY_WINDOW_SECONDS=86400
# Seconds a call to Resend may take before it counts as unavailable:
RESEND_TIMEOUT_SECONDS=5
# Sender of transactional email; required in staging and production (D4.3, #27):
# EMAIL_FROM="Jack Fix It <no-reply@example.invalid>"
# Service requests (D8.1, #42). Largest intake answers JSON, in bytes; most media per request:
REQUEST_INTAKE_MAX_BYTES=16384
REQUEST_MEDIA_MAX_ITEMS=10
# Requests a customer may create per window (seconds):
REQUEST_CREATE_LIMIT=10
REQUEST_CREATE_WINDOW_SECONDS=3600
# Reverse geocoding of the device position (D8.2, #215): seconds a call to Google may take
# before it counts as unavailable, and lookups a customer may make per window (seconds):
GEOCODING_TIMEOUT_SECONDS=5
GEO_REVERSE_LIMIT=30
GEO_REVERSE_WINDOW_SECONDS=600
# Requests per list page, by default and at most:
REQUEST_LIST_DEFAULT_LIMIT=20
REQUEST_LIST_MAX_LIMIT=50
# Characters of the description a pro sees in the opportunities list (#49):
OPPORTUNITY_EXCERPT_CHARS=160
# Pro profile (D6.1, #36): the most categories and service areas one pro may list:
PRO_MAX_CATEGORIES=5
PRO_MAX_SERVICE_AREAS=50
# Push notifications (D10.3, #54): seconds per Expo or Redis call, the receipt check interval
# (minutes), how long a ticket waits for its receipt, retry backoff, sends per device before a
# retryable error is final, devices per user:
PUSH_SEND_TIMEOUT_SECONDS=5
PUSH_RECEIPT_CHECK_MINUTES=15
PUSH_TICKET_TTL_SECONDS=86400
PUSH_RETRY_BACKOFF_SECONDS=30
PUSH_MAX_ATTEMPTS=5
PUSH_MAX_DEVICES_PER_USER=10
# Quote expiry (D9.4, #51): how often the worker expires quotes past their expires_at
# (minutes), and the longest one run may take (seconds):
QUOTE_EXPIRY_SWEEP_MINUTES=5
QUOTE_EXPIRY_TIMEOUT_SECONDS=240
# Stripe webhooks (D7.3, #40): how old a signature may be (seconds), the largest body read
# (bytes), the worker's runs of one event before it is failed, and the delay before a retry
# (seconds, times the attempt number):
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_WEBHOOK_MAX_BODY_BYTES=524288
STRIPE_WEBHOOK_MAX_ATTEMPTS=5
STRIPE_WEBHOOK_RETRY_BACKOFF_SECONDS=10
# Waitlist joins per client IP and per contact, per AUTH_RATE_LIMIT_WINDOW_SECONDS (D8.4, #46):
WAITLIST_JOIN_LIMIT=5
# Saved addresses one customer may keep in their address book (D8.2, #214):
SAVED_ADDRESSES_MAX_PER_USER=4
# Saved-address writes (create, edit, delete) a customer may make per window (seconds):
SAVED_ADDRESS_WRITE_LIMIT=30
SAVED_ADDRESS_WRITE_WINDOW_SECONDS=600
# Pro payouts through Stripe Connect Express (D7.1, #39): seconds one Stripe call may take,
# the SDK's retries of a call that failed on the network or a 409/429/5xx, seconds after a
# lost account create before the next call looks the account up in Stripe (under 86400, as
# Stripe may forget an idempotency key after 24 h), the most pages of 100 accounts that lookup
# reads, the API's public URL (Stripe sends the pro's browser back to its pages there; https
# in staging and production), the app link those pages open, and onboarding links a pro may
# ask for per window (seconds):
STRIPE_TIMEOUT_SECONDS=10
STRIPE_MAX_NETWORK_RETRIES=0
STRIPE_ACCOUNT_RECONCILE_AFTER_SECONDS=72000
STRIPE_ACCOUNT_LIST_MAX_PAGES=10
PUBLIC_API_URL=http://localhost:8000
PAYOUTS_ONBOARDING_APP_URL=jackfixit://payouts
PAYOUTS_ONBOARDING_LINK_LIMIT=10
PAYOUTS_ONBOARDING_LINK_WINDOW_SECONDS=600
# Customer payments (D11.1, #58): seconds after a lost PaymentIntent create before the next
# call searches Stripe for it instead of creating again (under 86400, as above):
STRIPE_PAYMENT_INTENT_RECONCILE_AFTER_SECONDS=72000
# Saved cards (#253): setup intents, default changes and deletes together that one customer
# may make per window (seconds):
PAYMENT_METHOD_WRITE_LIMIT=20
PAYMENT_METHOD_WRITE_WINDOW_SECONDS=600
# Pages of 100 cards read from Stripe for one customer (more cards than that: 503), and the
# seconds a default change or a delete may take in all: its wait for another change of the same
# wallet, then its own Stripe calls (keep it below the app's request timeout):
PAYMENT_METHOD_LIST_MAX_PAGES=5
PAYMENT_METHOD_CHANGE_TIMEOUT_SECONDS=10
# Unpaid payments (#297): seconds after its creation before a payment still unpaid is canceled
# (its quote reopens), how often the worker sweeps (minutes) and the longest one run may take
# (seconds):
PAYMENT_UNPAID_CANCEL_AFTER_SECONDS=7200
PAYMENT_UNPAID_SWEEP_MINUTES=10
PAYMENT_UNPAID_SWEEP_TIMEOUT_SECONDS=540
# Job execution (D12.2, #63): wrong arrival codes at check-in before the code locks:
ARRIVAL_CODE_MAX_ATTEMPTS=5
# Job photos (D12.2, #298): the most photos a job holds of each kind (before, after):
JOB_PHOTO_MAX_PER_KIND=10
# The oldest job_photo upload a job accepts, in minutes since its key was issued; at most half
# of ORPHAN_UPLOAD_MIN_AGE_HOURS (the API refuses to start otherwise):
JOB_PHOTO_ATTACH_MAX_AGE_MINUTES=720
# Job confirmation (#66, #67): hours the customer has to confirm a completed job before the
# system confirms it, how often the worker sweeps (minutes) and the longest one run may take
# (seconds):
JOB_AUTO_CONFIRM_AFTER_HOURS=48
JOB_AUTO_CONFIRM_SWEEP_MINUTES=15
JOB_AUTO_CONFIRM_SWEEP_TIMEOUT_SECONDS=840
# The pro's live position while on the way (#350): kept in Redis only, the latest one per job,
# for this many seconds; one sent sooner than the minimum interval (seconds) after the stored
# one is dropped; positions one pro may send per window (seconds) before a 429; how far a
# position's own time may be ahead of or behind the server's (seconds); and the longest wait
# on Redis for one position operation (seconds):
PRO_LOCATION_TTL_SECONDS=120
PRO_LOCATION_MIN_INTERVAL_SECONDS=3
PRO_LOCATION_RATE_LIMIT=60
PRO_LOCATION_RATE_WINDOW_SECONDS=60
PRO_LOCATION_MAX_FUTURE_SECONDS=300
PRO_LOCATION_MAX_AGE_SECONDS=600
PRO_LOCATION_TIMEOUT_SECONDS=0.5
# The Redis the positions live in (#350): one of their own that keeps nothing but its live
# keys (no RDB snapshot, no AOF, slow log off). Empty here: development and test use
# REDIS_URL's. Staging and production need it (docs/railway.md, "Live positions"); without
# it the position routes answer 503. Its deployed value holds a password: Railway only.
LOCATION_REDIS_URL=
# Seconds the API remembers what that Redis says it keeps before it asks again (CONFIG GET):
LOCATION_REDIS_RECHECK_SECONDS=60
# Only for a managed Redis that refuses CONFIG GET: true takes the deployer's word that it
# keeps nothing. It never overrides a Redis that says it keeps positions.
LOCATION_REDIS_ASSUME_EPHEMERAL=false
# Job chat (D14.1, #71): messages one user may send in one job's chat per window (seconds):
CHAT_MESSAGE_RATE_LIMIT=20
CHAT_MESSAGE_RATE_WINDOW_SECONDS=60
# Support tickets ("Talk to Jack", #274): tickets one user may write per window (seconds):
SUPPORT_TICKET_CREATE_LIMIT=5
SUPPORT_TICKET_CREATE_WINDOW_SECONDS=3600
# The original of a redacted chat message (#72): kept encrypted for staff for this many days;
# the worker's purge runs every N minutes, N rows per transaction, within the timeout (seconds):
CHAT_ORIGINAL_RETENTION_DAYS=90
CHAT_ORIGINAL_PURGE_MINUTES=60
CHAT_ORIGINAL_PURGE_BATCH=500
CHAT_ORIGINAL_PURGE_TIMEOUT_SECONDS=600
# Repeat offenders (#72): this many redacted messages of one sender within this many days flag
# the sender for the BDC:
CHAT_OFFENDER_THRESHOLD=3
CHAT_OFFENDER_WINDOW_DAYS=7

# Secrets added by later tasks. Values live only in Railway variables, never in the repo.
# JWT_SECRET=                    # D4.2 (#25)
# TWILIO_ACCOUNT_SID=            # D4.3 (#26)
# TWILIO_AUTH_TOKEN=             # D4.3 (#26)
# TWILIO_VERIFY_SERVICE_SID=     # D4.3 (#26)
# RESEND_API_KEY=                # D4.3 (#27)
# S3_ENDPOINT_URL=               # D6.2 (#35)
# S3_BUCKET=                     # D6.2 (#35)
# S3_ACCESS_KEY_ID=              # D6.2 (#35)
# S3_SECRET_ACCESS_KEY=          # D6.2 (#35)
# REFRESH_ROTATION_SECRET=       # #152 (32+ chars; HMAC key deriving each rotated refresh token)
# RATE_LIMIT_KEY_SECRET=         # #137 (32+ chars; HMAC key for emails and phones in rate-limit keys)
# STRIPE_SECRET_KEY=             # D7.1 (#39) a test key (sk_test_) outside production
# STRIPE_PUBLISHABLE_KEY=        # D11.1 (#58) the Payment Sheet's key, pk_test_ outside production; not secret, but per environment
# STRIPE_WEBHOOK_SECRET=         # D7.3 (#40)
# GOOGLE_MAPS_API_KEY=           # D8.2 (#215, #45) optional until the Google Cloud account exists (#14)
# EXPO_ACCESS_TOKEN=             # D10.3 (#54) optional; only with Expo enhanced push security
# CHAT_ORIGINAL_KEYS=            # #72 JSON {"<key id>": "<base64 32 bytes>"}; unset: no chat original is kept
# CHAT_ORIGINAL_ACTIVE_KEY_ID=   # #72 the key id new originals use (docs/railway.md, "Chat originals")

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/apps/api/**"]
  },
  "deploy": {
    "startCommand": "python -m app.serve",
    "preDeployCommand": "sh -c 'alembic upgrade head && python -m scripts.seed_categories && python -m scripts.seed_service_areas'",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}

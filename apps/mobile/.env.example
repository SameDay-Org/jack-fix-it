# Local development: cp .env.example .env   (never commit .env files)
# Non-secret build-time settings. EAS builds set them per profile in eas.json.

# development | preview | production. Suffixes the app name and bundle id (app.config.ts).
APP_VARIANT=development

# API base URL inlined into the JS bundle. Must be https:// outside development builds.
# Local device or emulator: http://<your computer's LAN IP>:8000 (emulator: http://10.0.2.2:8000)
EXPO_PUBLIC_API_URL=https://api.staging.jackfixit.invalid

# Request timeout of the API client, in milliseconds (D5.4, #32). Default 15000.
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Minimum password length shown as the sign-up hint (D5.3, #33). Mirrors the API's
# PASSWORD_MIN_LENGTH; the server stays the authority. Default 10.
EXPO_PUBLIC_PASSWORD_MIN_LENGTH=10

# Phone verification (D5.3 OTP, #138). The calling code shown before the number and prefixed to
# it; only +1 (US) is supported for now. Default +1.
EXPO_PUBLIC_PHONE_COUNTRY_CODE=+1

# Seconds "Resend code" waits after a code was sent. Default 30.
EXPO_PUBLIC_OTP_RESEND_SECONDS=30

# Media uploads (D6.2, #130). The two marked "Mirrors" follow an API setting; the server stays the
# authority. The others are the app's own.
# Fixed part of one file's PUT deadline, in milliseconds. Default 120000.
EXPO_PUBLIC_UPLOAD_TIMEOUT_MS=120000
# The PUT also gets the time to send the file at this rate (bytes per second; default 131072,
# about 1 Mbit/s), so a large video on a slow uplink is not cut off.
EXPO_PUBLIC_UPLOAD_MIN_BYTES_PER_SECOND=131072
# Images are resized so the long edge is at most this many pixels, then re-encoded as JPEG.
EXPO_PUBLIC_IMAGE_MAX_EDGE=2048
# JPEG quality of the re-encoded image, above 0 and at most 1.
EXPO_PUBLIC_IMAGE_QUALITY=0.8
# Largest video, in bytes (videos are not re-encoded). Mirrors UPLOAD_MAX_VIDEO_BYTES.
EXPO_PUBLIC_UPLOAD_MAX_VIDEO_BYTES=104857600
# Most photos and videos one request may carry. Mirrors REQUEST_MEDIA_MAX_ITEMS.
EXPO_PUBLIC_REQUEST_MEDIA_MAX=10
# Request flow (#45): how many days, from the first the API accepts, the When step offers.
EXPO_PUBLIC_REQUEST_DATE_DAYS=30
